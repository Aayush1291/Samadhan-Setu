# SamadhanSetu — Express admin/officer backend environment
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `server/.env` is git-ignored and must NEVER be committed. All values are read
# server-side only via process.env (loaded through `dotenv/config`).

# ── MongoDB ────────────────────────────────────────────────────────────────
# Shares the same cluster as the main app. Falls back to a local test database
# when unset (see server/src/db.ts).
MONGO_URL_SIH=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express admin API listens on (default 4000).
PORT=4000

# Allowed origin for the admin frontend (CORS). Default http://localhost:5173.
ADMIN_FRONTEND_ORIGIN=http://localhost:5173

# ── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign and verify admin JWTs. Use a long, random value.
# A weak dev-only fallback exists in code; always set this in any real deployment.
JWT_SECRET=your_long_random_jwt_secret_here

# ── Node ─────────────────────────────────────────────────────────────────────
# Set to "production" in deployed environments to enable secure cookies and
# stricter rate limits.
NODE_ENV=development
