# SamadhanSetu — frontend / TanStack Start server environment
#
# Copy this file to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed. All of these values
# are read server-side only (via process.env). None is VITE_-prefixed, so none
# is ever exposed to the browser bundle.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Atlas (or self-hosted) connection string. No default database is specified in
# the URI; the app supplies the database name at runtime.
MONGO_URL_SIH=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>

# ── Groq AI ────────────────────────────────────────────────────────────────
# Used for grievance classification and speech-to-text transcription.
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Meta WhatsApp Business API (OTP delivery — optional) ─────────────────────
# Leave blank to fall back to the development console OTP provider in non-prod.
META_WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_TEMPLATE_NAME=your_whatsapp_template_name_here

# ── Cloudinary (image evidence upload — optional) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
